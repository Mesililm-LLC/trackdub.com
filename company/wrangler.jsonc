{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "mesilim-company-preview",
  "main": "worker.mjs",
  "compatibility_date": "2026-07-29",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
  },
  "vars": { "SITE_ENV": "preview" },
  "observability": { "enabled": false },
  "env": {
    "preview": {
      "name": "mesilim-company-preview",
      "workers_dev": true,
      "vars": { "SITE_ENV": "preview" }
    },
    "production": {
      "name": "mesilim-company",
      "workers_dev": false,
      "vars": { "SITE_ENV": "production" },
      "routes": [
        { "pattern": "mesilim.org", "custom_domain": true },
        { "pattern": "www.mesilim.org", "custom_domain": true },
      ],
    },
  },
}
